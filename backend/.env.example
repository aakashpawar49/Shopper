# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env file.

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
# Port the Express API listens on (defaults to 3000 when unset).
PORT=3000

# ---------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------
# MongoDB connection string. Local example below; for MongoDB Atlas use
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopper
MONGO_URI=mongodb://127.0.0.1:27017/shopper

# Optional DNS override. Only needed when a mongodb+srv:// (Atlas) URI fails
# with "querySrv ECONNREFUSED" because Node cannot use your system DNS for SRV
# lookups. Comma-separated list of DNS servers for Node to use.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---------------------------------------------------------------
# Authentication (required)
# ---------------------------------------------------------------
# Secret used to sign JWTs. Use a long random string, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------
# Frontend URL (used for Stripe success/cancel redirects)
# ---------------------------------------------------------------
# Must match where the Vite dev server (or deployed frontend) is served.
# Use https://localhost:5173 if you run the dev server with a local certificate.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------
# Cloudinary (optional - needed for admin product image uploads)
# ---------------------------------------------------------------
# Find these on your Cloudinary dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# This is Cloudinary's "API Secret".
CLOUDINARY_SECRET_KEY=

# ---------------------------------------------------------------
# Stripe (optional - needed for card checkout)
# ---------------------------------------------------------------
# Secret key from https://dashboard.stripe.com/test/apikeys (starts with sk_test_ in test mode).
STRIPE_SECRET_KEY=
