# Copy this file to frontend/.env and fill in your own values.
# Vite only exposes variables prefixed with VITE_ to the browser, so never put
# secrets (database URLs, secret keys) in this file.

# Base URL of the backend API, without a trailing slash (required).
# Must match PORT in backend/.env.
VITE_BACKEND_URL=http://localhost:3000

# PayPal client ID (optional). Only used by components/Cart/PayPalButton.jsx,
# which is not wired into checkout yet.
VITE_PAYPAL_CLIENT_ID=
